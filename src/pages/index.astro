---
import Layout from "../layouts/Layout.astro";
import ProjectGrid from "../components/ProjectGrid.jsx";
import ExperienceRow from "../components/ExperienceRow.jsx";
import Footer from "../components/Footer.jsx";

import "../styles/projectCard.scss";

const workExperienceEn = [
  { title: "ChemAI", date: "Apr 2026 – Present", role: "Data Science Intern", icon: "/ChemAI.png", logoClass: "scale-[1.4]" },
  { title: "Batigère Maison Familiale", date: "Jul 2025 – Aug 2025", role: "Data Governance Intern", icon: "/Batigere.png" },
  { title: "Atos", date: "Jul 2024 – Aug 2024", role: "Software Engineer Intern", icon: "/Atos.png" },
];

const workExperienceFr = [
  { title: "ChemAI", date: "Avr 2026 – Présent", role: "Stagiaire Data Science", icon: "/ChemAI.png", logoClass: "scale-[1.4]" },
  { title: "Batigère Maison Familiale", date: "Juil 2025 – Août 2025", role: "Stagiaire en gouvernance des données", icon: "/Batigere.png" },
  { title: "Atos", date: "Juil 2024 – Août 2024", role: "Stagiaire Ingénieur Logiciel", icon: "/Atos.png" },
];

const educationEn = [
  {
    title: "École Polytechnique — Polytechnic Institute of Paris",
    date: "2025 – 2026 (expected)",
    role: "MSc Data Science",
    icon: "/X.png",
    url: "https://www.ip-paris.fr/education/masters/mention-mathematiques-appliquees-statistique/master-year-2-data-science",
  },
  {
    title: "Télécom SudParis — Polytechnic Institute of Paris",
    date: "2023 – 2026 (expected)",
    role: "Master's degree in Computer Science and Applied Mathematics",
    icon: "/TSP.png",
    logoClass: "scale-[1.2]",
    url: "https://www.telecom-sudparis.eu/formation/modelisations-statistiques-et-applications/",
  },
];

const educationFr = [
  {
    title: "École Polytechnique — Institut Polytechnique de Paris",
    date: "2025 – 2026 (prévu)",
    role: "MSc Data Science",
    icon: "/X.png",
    url: "https://www.ip-paris.fr/education/masters/mention-mathematiques-appliquees-statistique/master-year-2-data-science",
  },
  {
    title: "Télécom SudParis — Institut Polytechnique de Paris",
    date: "2023 – 2026 (prévu)",
    role: "Diplôme d'ingénieur en informatique et mathématiques appliquées",
    icon: "/TSP.png",
    logoClass: "scale-[1.2]",
    url: "https://www.telecom-sudparis.eu/formation/modelisations-statistiques-et-applications/",
  },
];
---

<Layout title="Maxence Debes">
  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section
    id="home"
    class="relative flex flex-col items-center justify-center w-full px-4 sm:px-6 md:px-8 lg:px-12 h-[100svh] -mt-[65px]"
  >
    <div class="flex flex-col lg:flex-row items-center justify-center w-full max-w-6xl gap-8 md:gap-16 lg:gap-32 xl:gap-40">
      <div class="w-full lg:w-auto flex flex-col items-stretch lg:items-start text-center lg:text-left">
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-black dark:text-white reveal-up">
          Maxence Debes
        </h1>
        <p class="mt-1 sm:mt-3 text-lg sm:text-2xl md:text-3xl text-black dark:text-white lg:pl-[1.5px]">
          <span data-i18n="hero.role" data-locale-fade class="text-pink-400 font-semibold reveal-up reveal-delay-100">
            Data Science Student
          </span>
        </p>
      </div>

      <div class="flex justify-center items-center mt-2 lg:mt-0 reveal-scale reveal-delay-200">
        <div class="w-40 sm:w-50 md:w-60 lg:w-72 aspect-square rounded-full border border-black/20 dark:border-white/20 overflow-hidden">
          <img
            src="/Profile_picture.jpg"
            alt="Photo"
            class="w-full h-full object-cover scale-135 lg:translate-x-5 lg:translate-y-7 translate-x-3 translate-y-3 transition-transform duration-500 hover:scale-[1.40]"
          />
        </div>
      </div>
    </div>

    <div class="absolute bottom-4 sm:bottom-8 left-1/2 -translate-x-1/2">
      <div class="flex flex-col items-center gap-2 reveal-up reveal-early" style={{ transitionDelay: "800ms" }}>
        <span data-i18n="scroll" class="text-xs font-bold tracking-widest text-black dark:text-white uppercase">Scroll</span>
        <div class="hidden sm:flex w-[30px] h-[50px] border border-black/50 dark:border-white/50 rounded-full justify-center p-1">
          <div class="w-1 h-2.5 bg-pink-400 rounded-full animate-bounce mt-[3px]"></div>
        </div>
        <div class="flex sm:hidden text-pink-400 animate-bounce mt-1">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ ABOUT ═══════════════════ -->
  <section id="about" class="px-6 md:px-12 text-black dark:text-white pt-20 pb-14">
    <div class="max-w-[1100px] mx-auto">
      <div class="mb-1 text-center reveal-up">
        <span data-i18n="about.label" class="text-xs font-bold tracking-widest text-pink-400 uppercase">About me</span>
      </div>
      <h2 data-i18n="about.heading" class="text-4xl font-bold text-black dark:text-white mb-8 md:mb-10 text-center reveal-up reveal-delay-100">
        About me
      </h2>
      <p data-i18n="about.bio" class="text-base sm:text-lg leading-relaxed mb-10 text-justify mobile-narrow text-black dark:text-white reveal-up reveal-delay-200">
        I am Maxence Debes, an MSc Data Science student with a strong academic background in Mathematics and Computer Science. My profile is deeply rooted in Data Science, with a strong specialization in Machine Learning and AI. I enjoy solving complex technical problems by combining mathematical rigor with advanced Python programming to build robust, data-driven solutions.
      </p>
    </div>

    <div class="max-w-[1100px] mx-auto">
      <h2 data-i18n="about.work" class="text-2xl font-semibold mb-8 section-title mobile-narrow text-black dark:text-white reveal-up reveal-delay-100">
        Work experience
      </h2>
      <div class="reveal-up reveal-delay-200 w-full mb-20 md:mb-24">
        <ExperienceRow client:load itemsEn={workExperienceEn} itemsFr={workExperienceFr} />
      </div>

      <h2 data-i18n="about.skills" class="text-2xl font-semibold mb-8 section-title mobile-narrow text-black dark:text-white reveal-up reveal-delay-100">
        Skills
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-16 gap-y-10 w-full">
        {[
          { key: "skills.langs", label: "Languages & Databases", chips: [
            { name: "Python", icon: "https://cdn.simpleicons.org/python" },
            { name: "Java", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg" },
            { name: "SQL", icon: "inline-db" },
            { name: "Neo4j", icon: "https://cdn.simpleicons.org/neo4j" },
          ] },
          { key: "skills.ml", label: "ML & Deep Learning", chips: [
            { name: "PyTorch", icon: "https://cdn.simpleicons.org/pytorch" },
            { name: "PyG", icon: "https://cdn.simpleicons.org/pyg" },
            { name: "Scikit-learn", icon: "https://cdn.simpleicons.org/scikitlearn" },
            { name: "PEFT", icon: "https://cdn.simpleicons.org/huggingface" },
          ] },
          { key: "skills.llm", label: "LLMs & MLOps", chips: [
            { name: "Transformers", icon: "https://cdn.simpleicons.org/huggingface" },
            { name: "Unsloth", icon: "/unsloth.png" },
            { name: "vLLM", icon: "https://cdn.simpleicons.org/vllm" },
            { name: "Ollama", icon: "https://cdn.simpleicons.org/ollama" },
            { name: "W&B", icon: "https://cdn.simpleicons.org/weightsandbiases" },
          ] },
          { key: "skills.tools", label: "Tools", chips: [
            { name: "Git", icon: "https://cdn.simpleicons.org/git" },
            { name: "Docker", icon: "https://cdn.simpleicons.org/docker" },
            { name: "Bash", icon: "https://cdn.simpleicons.org/gnubash" },
            { name: "Linux", icon: "https://cdn.simpleicons.org/linux" },
            { name: "LaTeX", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/latex/latex-original.svg" },
          ] },
          { key: "skills.dataviz", label: "Data analysis", chips: [
            { name: "NumPy", icon: "https://cdn.simpleicons.org/numpy" },
            { name: "SciPy", icon: "https://cdn.simpleicons.org/scipy" },
            { name: "Pandas", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/pandas/pandas-original.svg" },
            { name: "Matplotlib", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/matplotlib/matplotlib-plain.svg" },
          ] },
        ].map((card, i) => (
          <div class="reveal-up" style={{ transitionDelay: `${i * 160}ms` }}>
            <div>
              <h3 data-i18n={card.key} class="text-lg font-semibold mb-2.5 text-black dark:text-white text-center lg:text-left">{card.label}</h3>
              <div class="flex flex-wrap items-center gap-2 justify-center lg:justify-start">
                {card.chips.map((skill, index) => (
                  <>
                    {index > 0 && <div class="w-[1px] h-4 bg-black/15 dark:bg-white/15" aria-hidden="true"></div>}
                    <span class="px-2 text-sm font-medium text-black dark:text-white inline-flex items-center gap-1.5">
                      {skill.icon === "inline-db" ? (
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                        </svg>
                      ) : skill.icon ? (
                        <img src={skill.icon} alt="" class={skill.color ? "w-3.5 h-3.5" : "w-3.5 h-3.5 brightness-0 dark:invert"} aria-hidden="true" />
                      ) : null}
                      {skill.name}
                    </span>
                  </>
                ))}
              </div>
            </div>
          </div>
        ))}

        <div class="reveal-up" style={{ transitionDelay: "800ms" }}>
          <div>
            <h3 data-i18n="skills.lang" class="text-lg font-semibold mb-2.5 text-black dark:text-white text-center lg:text-left">Spoken languages</h3>
            <div class="flex flex-wrap items-center gap-2 justify-center lg:justify-start">
              <span data-locale-fade class="px-2 text-sm font-medium text-black dark:text-white inline-flex items-center gap-1.5">
                <span class="grayscale">🇫🇷</span>
                <span data-i18n="lang.french">French (native)</span>
              </span>
              <div class="w-[1px] h-4 bg-black/15 dark:bg-white/15" aria-hidden="true"></div>
              <span data-locale-fade class="px-2 text-sm font-medium text-black dark:text-white inline-flex items-center gap-1.5">
                <span class="grayscale">🇬🇧</span>
                <span data-i18n="lang.english">English (C1)</span>
              </span>
              <div class="w-[1px] h-4 bg-black/15 dark:bg-white/15" aria-hidden="true"></div>
              <span data-locale-fade class="px-2 text-sm font-medium text-black dark:text-white inline-flex items-center gap-1.5">
                <span class="grayscale">🇩🇪</span>
                <span data-i18n="lang.german">German (A2)</span>
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="w-full h-20 md:h-24"></div>

      <h2 data-i18n="about.education" class="text-2xl font-semibold mb-8 section-title mobile-narrow text-black dark:text-white reveal-up reveal-delay-100">
        Education
      </h2>
      <div class="reveal-up reveal-delay-200 w-full">
        <ExperienceRow client:load itemsEn={educationEn} itemsFr={educationFr} />
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PROJECTS ═══════════════════ -->
  <section id="projects" class="pt-20 pb-14">
    <main class="flex flex-col items-center px-4 w-full mx-auto">
      <div class="max-w-[1280px] lg:max-w-[1162px] mx-auto pb-6 px-4 sm:px-6 md:px-8">
        <div class="mb-1 text-center reveal-up">
          <span data-i18n="projects.label" class="text-xs font-bold tracking-widest text-pink-400 uppercase">My projects</span>
        </div>
        <h2 data-i18n="projects.heading" class="text-4xl font-bold text-black dark:text-white text-center md:mb-10 mb-8 reveal-up reveal-delay-100">
          My projects
        </h2>
        <p data-i18n="projects.desc" class="text-base sm:text-lg leading-relaxed text-justify mobile-narrow mb-6 md:mb-8 text-black dark:text-white reveal-up reveal-delay-200">
          A mix of academic research, personal builds, and professional work, all centered around AI, data, and software engineering. Some explore ideas I was simply curious about, others solve problems I ran into along the way. Most link to a repository if you want to dig into the code, and a few are still evolving as I keep iterating on them.
        </p>
      </div>
      <div class="max-w-[1280px] lg:max-w-[1162px] mx-auto px-4 sm:px-6 md:px-8 w-full">
        <ProjectGrid client:load />
      </div>
    </main>
  </section>

  <!-- ═══════════════════ CONTACT ═══════════════════ -->
  <section id="contact" class="pt-20 pb-0 min-h-[calc(100svh-35px)] flex flex-col">
    <div class="max-w-[1100px] w-full mx-auto px-6 md:px-12 flex flex-col items-center relative z-10">
      <div class="mb-1 text-center reveal-up">
        <span data-i18n="contact.label" class="text-xs font-bold tracking-widest text-pink-400 uppercase">Let's connect</span>
      </div>
      <h2 data-i18n="contact.heading" class="text-4xl md:text-5xl font-bold text-black dark:text-white mb-0 text-center reveal-up reveal-delay-100">
        Let's connect
      </h2>
    </div>

    <div class="flex-1 flex flex-col items-center justify-center w-full">
    <div class="w-full relative z-10 mt-10 md:mt-16">
      <div class="max-w-[1100px] w-full mx-auto px-6 md:px-12 flex flex-col items-center gap-14">
          <div class="w-full max-w-[784px] mx-auto reveal-up reveal-delay-200">
            <form
              id="contact-form"
              action="https://api.web3forms.com/submit"
              method="POST"
              class="flex flex-col gap-7"
            >
              <input type="hidden" name="access_key" value="b7a332b3-794a-40fe-999e-e85a68145764" />
              <input type="hidden" id="form-subject" name="subject" value="New message from your Portfolio" />
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
                <div class="flex flex-col gap-1.5">
                  <label for="name" data-i18n="contact.name" class="text-xs tracking-wide text-black/60 dark:text-white/60">Name</label>
                  <input type="text" id="name" name="name" required autocomplete="none" class="w-full bg-transparent border-0 border-b border-black/15 dark:border-white/15 px-0 py-2.5 text-black dark:text-white placeholder:text-black/30 dark:placeholder:text-white/30 focus:outline-none focus:border-pink-400 dark:focus:border-pink-400 transition-colors font-medium text-sm" />
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="email" data-i18n="contact.email" class="text-xs tracking-wide text-black/60 dark:text-white/60">Email</label>
                  <input type="email" id="email" name="email" required autocomplete="none" class="w-full bg-transparent border-0 border-b border-black/15 dark:border-white/15 px-0 py-2.5 text-black dark:text-white placeholder:text-black/30 dark:placeholder:text-white/30 focus:outline-none focus:border-pink-400 dark:focus:border-pink-400 transition-colors font-medium text-sm" />
                </div>
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="message" data-i18n="contact.message" class="text-xs tracking-wide text-black/60 dark:text-white/60">Message</label>
                <textarea id="message" name="message" required autocomplete="none" rows="4" class="w-full bg-transparent border-0 border-b border-black/15 dark:border-white/15 px-0 py-2.5 text-black dark:text-white placeholder:text-black/30 dark:placeholder:text-white/30 focus:outline-none focus:border-pink-400 dark:focus:border-pink-400 transition-colors font-medium text-sm resize-none"></textarea>
              </div>
              <button
                id="submit-button"
                type="submit"
                class="mt-2 self-center sm:self-start flex items-center justify-center gap-2 text-black dark:text-white hover:text-pink-400 dark:hover:text-pink-400 font-semibold cursor-pointer text-sm transition-colors duration-300 group"
              >
                <span data-i18n="contact.send">Send message</span>
                <svg data-locale-fade xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"></path>
                </svg>
              </button>
            </form>
          </div>

          <p data-i18n="contact.desc" class="text-base sm:text-lg leading-relaxed text-justify sm:text-left text-black/80 dark:text-white w-full mobile-narrow reveal-up reveal-early reveal-delay-400">
            Whether you have a question, a project idea, or just want to chat, my inbox is always open. I'll do my best to get back to you!
          </p>
        </div>
      </div>
    </div>

    <div class="w-full pt-16">
      <Footer client:load />
    </div>
  </section>

  <style>
    .section-title { text-align: left; }
    @media (max-width: 768px) {
      .mobile-narrow { max-width: 95%; margin-left: auto; margin-right: auto; line-height: 1.7; }
    }
    @media (max-width: 1024px) {
      .mobile-narrow { margin-left: auto; margin-right: auto; line-height: 1.7; }
    }
  </style>
</Layout>

<script>
  // ── Translations ──────────────────────────────────────────────────────────
  const translations: Record<string, Record<string, string>> = {
    en: {
      'hero.role': 'Data Science Student',
      'scroll': 'Scroll',
      'about.label': 'About me',
      'about.heading': 'About me',
      'about.bio': 'I am Maxence Debes, an MSc Data Science student with a strong academic background in mathematics and computer science. My profile is deeply rooted in Data Science, with a strong specialization in Machine Learning and AI. I enjoy solving complex technical problems by combining mathematical rigor with advanced Python programming to build robust, data-driven solutions.',
      'about.work': 'Work experience',
      'about.skills': 'Skills',
      'skills.langs': 'Languages & Databases',
      'skills.ml': 'ML & Deep Learning',
      'skills.dataviz': 'Data analysis',
      'skills.llm': 'LLMs & MLOps',
      'skills.tools': 'Tools',
      'skills.lang': 'Spoken languages',
      'lang.french': 'French (native)',
      'lang.english': 'English (C1)',
      'lang.german': 'German (A2)',
      'about.education': 'Education',
      'projects.label': 'My projects',
      'projects.heading': 'My projects',
      'projects.desc': 'A mix of academic research, personal builds, and professional work, all centered around AI, data, and software engineering. Some explore ideas I was simply curious about, others solve problems I ran into along the way. Most link to a repository if you want to dig into the code, and a few are still evolving as I keep iterating on them.',
      'contact.label': "Let's connect",
      'contact.heading': "Let's connect",
      'contact.desc': "Whether you have a question, a project idea, or just want to chat, my inbox is always open. I'll do my best to get back to you!",
      'contact.open': 'Open to new opportunities',
      'contact.name': 'Name',
      'contact.email': 'Email',
      'contact.message': 'Message',
      'contact.send': 'Send message',
    },
    fr: {
      'hero.role': 'Étudiant en Data Science',
      'scroll': 'Scroll',
      'about.label': 'À propos',
      'about.heading': 'À propos',
      'about.bio': "Je suis Maxence Debes, étudiant en MSc Data Science avec une solide formation académique en mathématiques et en informatique. Mon profil est profondément ancré dans la Data Science, avec une forte spécialisation en Machine Learning et en IA. J'aime résoudre des problèmes techniques complexes en combinant rigueur mathématique et programmation Python avancée pour construire des solutions robustes, guidées par les données.",
      'about.work': 'Expérience professionnelle',
      'about.skills': "Compétences",
      'skills.langs': 'Langages & Bases de données',
      'skills.ml': 'ML & Deep Learning',
      'skills.dataviz': 'Analyse de données',
      'skills.llm': 'LLMs & MLOps',
      'skills.tools': 'Outils',
      'skills.lang': 'Langues',
      'lang.french': 'Français (maternel)',
      'lang.english': 'Anglais (C1)',
      'lang.german': 'Allemand (A2)',
      'about.education': 'Formation',
      'projects.label': 'Mes projets',
      'projects.heading': 'Mes projets',
      'projects.desc': "Un mélange de recherche académique, de projets personnels et d'expériences professionnelles, tous centrés sur l'IA, la data et le développement logiciel. Certains explorent des idées qui m'intriguaient simplement, d'autres répondent à des problèmes rencontrés en cours de route. La plupart renvoient vers un repository si vous voulez creuser le code, et certains sont encore en évolution au fil de mes améliorations.",
      'contact.label': 'Contactez-moi',
      'contact.heading': 'Contactez-moi',
      'contact.desc': "Une question, une idée de projet, ou simplement envie d'échanger, ma messagerie est toujours ouverte. Je ferai de mon mieux pour vous répondre !",
      'contact.open': "À l'écoute d'opportunités",
      'contact.name': 'Nom',
      'contact.email': 'Email',
      'contact.message': 'Message',
      'contact.send': 'Envoyer le message',
    }
  };

  const formSubjects: Record<string, string> = {
    en: 'New message from your Portfolio',
    fr: 'Nouveau message depuis ton Portfolio',
  };

  function applyLocaleStatic(locale: string) {
    const t = translations[locale];
    if (!t) return;
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18n!;
      if (t[key] !== undefined) el.textContent = t[key];
    });
    const subjectEl = document.getElementById('form-subject') as HTMLInputElement | null;
    if (subjectEl) subjectEl.value = formSubjects[locale] || formSubjects.en;
  }

  window.switchLocale = async (newLocale: string) => {
    const els = [
      ...document.querySelectorAll('[data-i18n], [data-locale-fade]'),
      ...document.querySelectorAll('.card'),
    ] as HTMLElement[];

    // Pick the section closest to the top of the viewport as scroll anchor
    const sections = [...document.querySelectorAll('section')] as HTMLElement[];
    const anchor = sections.reduce((best, s) => {
      const top = s.getBoundingClientRect().top;
      const bestTop = best.getBoundingClientRect().top;
      return Math.abs(top) < Math.abs(bestTop) ? s : best;
    }, sections[0]);

    sections.forEach(s => {
      // section-bg-reveal sections have a ::before wave pseudo-element positioned
      // at top:-72px. Locking overflow:hidden clips it, and changing the inline
      // height style can restart the infinite CSS animation. Skip those sections
      // and let the scroll-correction handle any positional delta.
      if (s.classList.contains('section-bg-reveal')) return;
      s.style.height = s.offsetHeight + 'px';
      s.style.overflow = 'hidden';
    });

    // Lock widths before fade-out to prevent layout shift
    els.forEach(el => {
      const w = el.getBoundingClientRect().width;
      if (w > 0) { el.style.width = w + 'px'; el.style.boxSizing = 'border-box'; }
    });

    els.forEach(el => {
      el.style.transition = 'opacity 0.15s ease-in';
      el.style.opacity = '0';
    });
    await new Promise(r => setTimeout(r, 150));

    applyLocaleStatic(newLocale);
    localStorage.setItem('locale', newLocale);
    document.documentElement.lang = newLocale;
    document.documentElement.setAttribute('data-locale', newLocale);
    document.dispatchEvent(new CustomEvent('locale-change', { detail: { locale: newLocale } }));

    // Release width locks while invisible — layout reflows here, unseen
    els.forEach(el => { el.style.width = ''; el.style.boxSizing = ''; });

    await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));

    // Capture anchor position now (after React re-renders, sections still locked)
    // so the reference is fresh and not stale from before the 150ms fade-out.
    const anchorTopBefore = anchor.getBoundingClientRect().top;

    // Stop Lenis during correction so it can't override the scroll in the same frame
    const lenis = (window as any).lenis;
    if (lenis) lenis.stop();

    // Release + measure + correct scroll in one synchronous block — no paint between them
    sections.forEach(s => { s.style.height = ''; s.style.overflow = ''; });
    const delta = anchor.getBoundingClientRect().top - anchorTopBefore;
    if (delta !== 0) {
      window.scrollBy({ top: delta, behavior: 'instant' });
    }

    // Sync Lenis's virtual position and resume
    if (lenis) {
      lenis.targetScroll = window.scrollY;
      lenis.animatedScroll = window.scrollY;
      lenis.start();
    }

    await new Promise(r => setTimeout(r, 50));

    els.forEach(el => {
      el.style.transition = 'opacity 0.3s ease-out';
      el.style.opacity = '1';
    });
    await new Promise(r => setTimeout(r, 350));
    els.forEach(el => {
      el.style.transition = '';
      el.style.opacity = '';
      el.style.filter = '';
    });
  };

  // Apply on initial page load (no animation)
  const initialLocale = localStorage.getItem('locale') || 'en';
  if (initialLocale !== 'en') applyLocaleStatic(initialLocale);
  // Notify React components of initial locale
  document.dispatchEvent(new CustomEvent('locale-change', { detail: { locale: initialLocale } }));

  // Re-apply on Astro internal navigation
  document.addEventListener('astro:after-swap', () => {
    const locale = localStorage.getItem('locale') || 'en';
    if (locale !== 'en') applyLocaleStatic(locale);
    document.dispatchEvent(new CustomEvent('locale-change', { detail: { locale } }));
  });
</script>

<script>
  // ── Contact form ──────────────────────────────────────────────────────────
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement;

  if (form && submitButton) {
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      const locale = localStorage.getItem('locale') || 'en';
      const sendingLabel = locale === 'fr' ? 'Envoi en cours...' : 'Sending...';
      const successLabel = locale === 'fr' ? 'Message envoyé !' : 'Message sent!';
      const errorMsg = locale === 'fr'
        ? "Une erreur est survenue. Merci de réessayer ou de me contacter directement par email."
        : "Something went wrong. Please try again or email me directly.";
      const networkErrorMsg = locale === 'fr'
        ? "Une erreur de connexion est survenue. Merci de réessayer."
        : "Something went wrong. Please check your connection and try again.";

      const originalButtonHtml = submitButton.innerHTML;
      submitButton.innerHTML = sendingLabel;
      submitButton.disabled = true;
      submitButton.classList.add("opacity-70", "cursor-not-allowed");

      const formData = new FormData(form);
      const json = JSON.stringify(Object.fromEntries(formData));

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: json,
        });
        const result = await response.json();
        if (response.status == 200) {
          submitButton.innerHTML = `${successLabel} <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-green-500"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;
          submitButton.classList.remove("hover:text-pink-400", "dark:hover:text-pink-400");
          form.reset();
        } else {
          submitButton.innerHTML = originalButtonHtml;
          submitButton.disabled = false;
          submitButton.classList.remove("opacity-70", "cursor-not-allowed");
          alert(result.message || errorMsg);
        }
      } catch {
        submitButton.innerHTML = originalButtonHtml;
        submitButton.disabled = false;
        submitButton.classList.remove("opacity-70", "cursor-not-allowed");
        alert(networkErrorMsg);
      }
    });
  }
</script>
